# Salin menjadi .env untuk mencoba login di komputer sendiri.
# Nilai yang sama diisi di Netlify: Site configuration → Environment variables.
# Keduanya aman untuk browser. JANGAN pernah mengisi secret key (sb_secret_...) di sini.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
